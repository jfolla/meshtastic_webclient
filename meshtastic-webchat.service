[Unit]
Description=Meshtastic Web Chat
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=meshtastic
Group=meshtastic
WorkingDirectory=/home/meshtastic/meshtastic_webchat
ExecStart=/home/meshtastic/meshtastic_webchat/start_webchat.sh
Restart=always
RestartSec=5
KillMode=control-group

[Install]
WantedBy=multi-user.target
