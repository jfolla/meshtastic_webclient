[Unit]
Description=Meshtastic Web Chat
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=meshtastic
Group=meshtastic
WorkingDirectory=/home/meshtastic/meshtastic_webchat
ExecStart=/home/meshtastic/meshtastic_webchat/start_webchat.sh
Restart=always
RestartSec=5
TimeoutStopSec=15
KillMode=control-group
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
